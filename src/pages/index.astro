    :global(.motion) .feed__phone {
      position: relative;
      grid-area: 1 / 2;
      justify-self: center;
      display: block;
      width: calc(var(--pw) + 2 * var(--bz));
      height: calc(var(--ph) + 2 * var(--bz));
      border: var(--bz) solid var(--ink);
      border-radius: var(--r-phone);
      pointer-events: none;
    }
    :global(.motion) .feed__phone::before {
      content: "";
      position: absolute;
      top: 10px;
      left: calc(50% - 40px);
      width: 80px;
      height: 22px;
      border-radius: 11px;
      background: var(--ink);
    }
    :global(.motion) .feed__slab {
      grid-area: 1 / 2;
      display: block;
      height: 72%;
      margin-left: 50%;
      margin-right: calc(-1 * var(--edge));
      border-radius: var(--r-xl) 0 0 var(--r-xl);
      background: var(--orange);
    }
    /* Two identical keyframes: changing the name is what restarts the kick on every step. */
    :global(.motion) .feed[data-step="0"] .feed__slab,
    :global(.motion) .feed[data-step="2"] .feed__slab {
      animation: kick-a 0.4s steps(4, jump-end);
    }
    :global(.motion) .feed[data-step="1"] .feed__slab {
      animation: kick-b 0.4s steps(4, jump-end);
    }
  }

  @keyframes chat-in {
    from {
      opacity: 0;
      translate: 0 12px;
    }
  }
  @keyframes pop {
    from {
      scale: 0.6;
      rotate: -8deg;
    }
    60% {
      scale: 1.12;
      rotate: 3deg;
    }
    to {
      scale: 1;
      rotate: 0deg;
    }
  }
  @keyframes float-up {
    from {
      opacity: 1;
      translate: 0 0;
    }
    to {
      opacity: 0;
      translate: var(--x, 0) -96px;
    }
  }
  @keyframes kick-a {
    40% {
      translate: 0 -32px;
    }
  }
  @keyframes kick-b {
    40% {
      translate: 0 -32px;
    }
  }

  /* About */
  .about-section {
    padding-top: clamp(48px, 6vw, 88px);
  }

  .about {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 40px;
  }

  .about__plate {
    display: block;
    border-radius: 0 32px 32px 0;
    background: var(--tint);
  }

  /* --w is the art's width; the negative margin (16% of the width is 24% of
     a 3:2 image's height) cancels the lift, so the plate ends where the art
     does. On phones it is centred on the screen and wider than it: the PNG's
     empty sides take the crop. */
  .about__art {
    --w: 116cqi;
    --y: -24%;
    display: block;
    width: var(--w);
    margin-inline-start: calc(-1 * var(--edge) - 8cqi);
    margin-bottom: calc(var(--w) * -0.16);
    translate: 0 var(--y);
  }

  .about__art :global(img) {
    width: 100%;
  }

  .about__copy {
    display: grid;
    align-content: start;
    gap: 22px;
  }

  .about__lead {
    font-size: clamp(1.375rem, 1.1rem + 1.1vw, 1.875rem);
    line-height: 1.6;
  }

  .about__conclusion {
    margin-top: clamp(56px, 12vw, 180px);
    font-size: clamp(1.5rem, 0.9rem + 2.8vw, 3.25rem);
  }

  /* TikTok Shop: one whole-panel link with the same weight as the service
     panels, its art lifted out of the top. The top margin is room for the
     lifted art, so it stays off the conclusion above. */
  .tiktok-entry {
    --pad: clamp(24px, 4cqi, 64px);
    grid-template-columns: minmax(0, 1fr);
    gap: 24px;
    margin-top: clamp(140px, 22vw, 240px);
    padding-block: var(--pad);
  }

  /* As .svc__art: the bottom margin (22.7% of the width is 34% of a 3:2
     image's height) cancels the lift. Centred on the screen on phones. */
  .tiktok-entry__art {
    --w: 100cqi;
    --y: -34%;
    display: block;
    width: var(--w);
    margin-inline-start: calc(50% - var(--w) / 2);
    margin-bottom: calc(var(--w) * -0.227);
    translate: 0 var(--y);
  }

  .tiktok-entry__art :global(img) {
    width: 100%;

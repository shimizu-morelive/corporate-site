  @media (min-resolution: 2dppx) {
    :global(.motion) .post__scene {
      --snap: 64px;
    }
  }

  @media (min-resolution: 3dppx) {
    :global(.motion) .post__scene {
      --snap: calc(128px / 3);
    }
  }

  /* Narrow screens and the PC phone: a smaller name and a tighter bar. The
     name goes only where it would meet the 01/03 badge (320px phones) or run
     past a very small PC phone. */
  @container (max-width: 360px) {
    :global(.motion) .post__top {
      gap: 6px;
    }
    :global(.motion) .post__handle {
      font-size: 0.6875rem;
    }
  }

  @container (max-width: 240px) {
    .post__handle {
      display: none;
    }
  }

  @media (max-width: 340px) {
    .post__handle {
      display: none;
    }
  }

  /* Short screens: two comments, a smaller card. */
  @media screen and (min-height: 500px) and (max-height: 700px) {
    :global(.motion) .feed {
      --chat: 80px;
    }
    :global(.motion) .post__chat span:nth-child(n + 3) {
      display: none;
    }
    :global(.motion) .post__chat {
      margin-bottom: 4px;
    }
  }

  /* The smallest phones keep the scene in view: no comments. */
  @media screen and (min-height: 500px) and (max-height: 600px) {
    :global(.motion) .feed {
      --chat: 0px;
    }
    :global(.motion) .post__chat {
      display: none;
    }
    /* The message takes three lines here: the shade reaches above the lead. */
    :global(.motion) .post__scene {
      --words: calc(var(--card) + 210px);
    }
  }

  /* Wide landscape screens: a phone at the right shows the LIVE screen, and
     the message itself is set large beside it, swapped once each post has
     landed. */
  @media screen and (min-width: 1024px) and (min-height: 500px) and (min-aspect-ratio: 1 / 1) {
    :global(.motion) .feed {
      --ph: min(calc(var(--h) - 2 * clamp(24px, 4svh, 48px)), 780px);
      --pw: calc(var(--ph) * 0.48);
      --bz: 12px;
      --r-phone: 56px;
      --cols: minmax(0, 1fr) calc(var(--pw) + 2 * var(--bz));
      --gap: clamp(40px, 6vw, 112px);
      margin-inline: 0;
    }
    :global(.motion) .feed__stage {
      grid-template-columns: var(--cols);
      column-gap: var(--gap);
      align-items: center;
      padding-block: 0;
    }
    :global(.motion) .feed__posts {
      grid-area: 1 / 1 / 2 / 3;
      align-self: stretch;
      overflow: visible;
      border-radius: 0;
    }
    :global(.motion) .post {
      grid-template-columns: var(--cols);
      grid-template-rows: 1fr auto auto 1fr;
      column-gap: var(--gap);
      align-content: stretch;
      align-items: end;
      gap: 0 var(--gap);
      padding: 0;
      border-radius: 0;
      background: none;
      color: var(--ink);
      translate: none;
      scale: none;
    }
    :global(.motion) .post::after {
      content: none;
    }
    /* The three phones share one cell: only the sliding shot takes the pointer,
       or the top post's empty screen would catch every click meant for the one on show. */
    :global(.motion) .post {
      pointer-events: none;
    }
    :global(.motion) .post__shot {
      pointer-events: auto;
    }
    :global(.motion) .post__media {
      position: relative;
      inset: auto;
      grid-area: 1 / 2 / -1 / 3;
      align-self: center;
      justify-self: center;
      width: var(--pw);
      height: var(--ph);
      border-radius: calc(var(--r-phone) - var(--bz));
    }
    :global(.motion) .post__shot {
      background: var(--ground);
      translate: 0 calc(var(--in) * 100%);
      scale: calc(1 - var(--out) * 0.12);
      transform-origin: 50% 30%;
    }
    :global(.motion) .post__shot::after {
      content: "";
      position: absolute;
      inset: 0;
      background: var(--ink);
      opacity: calc(var(--out) * 0.7);
      pointer-events: none;
    }
    /* Only the comments and the card need a shade here: the words are beside the phone. */
    :global(.motion) .post__scene {
      --words: calc(var(--card) + 130px);
    }
    :global(.motion) .post__scene::after {
      height: calc(var(--words) + 24px);
      background: linear-gradient(transparent 0 24px, rgb(17 17 17 / 0.3) 0 64px, rgb(17 17 17 / 0.55) 0);
    }
    :global(.motion) .post__top {
      top: 44px;
      left: 14px;
    }
    /* Over the phone's screen, outside the sliding shot: they rise in once the post has landed. */
    :global(.motion) .post__chat {
      grid-area: 1 / 2 / -1 / 3;
      align-self: end;
      width: calc(var(--pw) - 14px - 76px);
      margin: 0 0 calc((var(--h) - var(--ph)) / 2 + 14px + var(--card) + 14px) calc(var(--bz) + 14px);
    }
    :global(.motion) .post__count {
      position: static;
      grid-area: 2 / 1;
      margin-bottom: 24px;
      padding: 0;
      background: none;
      color: var(--muted);
      font-size: clamp(1rem, 0.6rem + 0.6vw, 1.25rem);
    }
    :global(.motion) .post__count b {
      color: var(--orange);
      font-size: clamp(2.5rem, 1rem + 2.2vw, 3.75rem);
      letter-spacing: -0.02em;
    }
    :global(.motion) .post__caption {
      grid-area: 3 / 1;
      align-self: start;
    }
    :global(.motion) .post__lead {
      color: var(--orange);
      font-size: clamp(1.25rem, 0.9rem + 0.9vw, 2rem);
    }
    :global(.motion) .post__text {
      font-size: min(clamp(2.25rem, 1rem + 2.4vw, 3.5rem), 7svh, 100cqi / 8.5);
    }
    /* The words beside the phone go with the scroll, as the screens do: they rise in while their post
       slides up and leave upward with it, gone by halfway so two messages never overlap. */
    :global(.motion) .post__count,
    :global(.motion) .post__caption {
      opacity: calc(1 - 2 * (var(--in) + var(--out)));
      translate: 0 calc((var(--in) - var(--out)) * 48px);
    }

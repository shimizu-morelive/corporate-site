    :global(.motion) .feed__stage::before {
      content: "";
      grid-area: 1 / 2;
      justify-self: center;
      width: var(--pw);
      height: var(--ph);
      border-radius: calc(var(--r-phone) - var(--bz));
      background: var(--ink);
    }
